# social-web — required environment variables
# Copy this file to `.env` and fill in the values.

# Supabase Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase Publishable (anon) key
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Cloudflare Turnstile site key (public). The secret key belongs in
# Supabase Dashboard > Authentication > Attack Protection.
# Local dev: use test pair 1x00000000000000000000AA /
# 1x0000000000000000000000000000000AA (secret in Supabase).
TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# Supabase transaction pooler URI (port 6543) for local scripts and tests.
# URL-encode reserved characters in the password.
# The Worker reaches Postgres through Hyperdrive, which must use the session
# pooler instead: same host and user, port 5432. See docs/deployment.md.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@YOUR_POOLER_HOST:6543/postgres
